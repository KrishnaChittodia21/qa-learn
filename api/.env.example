# qa-api settings. Copy to .env (never committed) and fill in.

# qa-learn's own Atlas cluster in production; a local mongod in development
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=qa_learn

# 3001, so system-design-learn's service (3000) can run alongside
PORT=3001
# this machine only; a deployment behind a proxy sets HOST=0.0.0.0
HOST=127.0.0.1
# the qa-learn frontend; the browser reaches the service through it (/api is proxied)
APP_URL=http://localhost:5173
# comma-separated browser origins allowed to call the service (defaults to APP_URL)
# CORS_ORIGINS=

# proxies in front of the service in production (Vercel rewrite + Render = 2); 0 locally
TRUST_PROXY_HOPS=0
# production only: the same value as on Vercel, at least 32 characters (openssl rand -base64 32)
# PROXY_SECRET=

RATE_LIMIT_PER_MINUTE=120
LOG_LEVEL=info

# sign-in: at least 32 random characters (openssl rand -base64 32); its own value, never system-design-learn's
BETTER_AUTH_SECRET=

# email for confirm and reset links. Unset in development: the links are printed in the service log instead.
# Gmail: SMTP_USER=you@gmail.com and SMTP_PASS=<app password>. A provider: also SMTP_HOST, SMTP_PORT and SMTP_FROM.
# SMTP_USER=
# SMTP_PASS=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_FROM=
EMAILS_PER_DAY=280

# picture uploads (optional; built-in avatars work without it): cloudinary://<api key>:<api secret>@<cloud name>
# CLOUDINARY_URL=

# Cloudflare Turnstile secret for the sign-up CAPTCHA (required in production)
# TURNSTILE_SECRET_KEY=
