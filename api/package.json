{
  "name": "qa-api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.ts",
    "start": "node --env-file-if-exists=.env src/server.ts",
    "build": "tsc",
    "test": "node --no-warnings --test 'test/**/*.test.ts'",
    "sync:answers": "node --no-warnings --env-file-if-exists=.env src/sync-answer-keys.ts"
  },
  "dependencies": {
    "@fastify/cors": "11.3.1",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.2.1",
    "fastify": "5.12.7",
    "mongodb": "7.7.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "~6.0.2"
  }
}
